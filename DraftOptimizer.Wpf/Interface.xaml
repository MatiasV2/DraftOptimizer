<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="BrandLogo">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,128,128" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <LinearGradientBrush EndPoint="1,1">
              <GradientStop Color="#1B2B3D" />
              <GradientStop Color="#0C151F" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="4,4,120,120" RadiusX="30" RadiusY="30" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#101D29" Geometry="M64 15 L103 30 V58 C103 84 88 101 64 114 C40 101 25 84 25 58 V30 Z">
          <GeometryDrawing.Pen>
            <Pen Thickness="4" LineJoin="Round">
              <Pen.Brush>
                <LinearGradientBrush EndPoint="1,1">
                  <GradientStop Color="#83F1D1" />
                  <GradientStop Color="#25B99C" Offset="1" />
                </LinearGradientBrush>
              </Pen.Brush>
            </Pen>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M43 46 H59 M43 64 H59 M43 82 H59">
          <GeometryDrawing.Pen>
            <Pen Brush="#536A7D" Thickness="4" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#72DFC1">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <EllipseGeometry Center="38,46" RadiusX="4" RadiusY="4" />
              <EllipseGeometry Center="38,64" RadiusX="4" RadiusY="4" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#F0C66C">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="38,82" RadiusX="4" RadiusY="4" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M59 46 C70 46 72 55 77 60 M59 64 H77 M59 82 C70 82 72 73 77 68">
          <GeometryDrawing.Pen>
            <Pen Brush="#72DFC1" Thickness="3.5" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#72DFC1" Geometry="M84 64 L92 56 V72 Z" />
        <GeometryDrawing Brush="#163C39">
          <GeometryDrawing.Pen>
            <Pen Brush="#68E2C0" Thickness="3" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="99,64" RadiusX="13" RadiusY="13" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#F3CB70" Geometry="M99 55 L101.7 60.7 108 61.6 103.5 66 104.6 72.2 99 69.2 93.4 72.2 94.5 66 90 61.6 96.3 60.7 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <Style x:Key="DraftTabs" TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,4,0,0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DraftTab" TargetType="TabItem">
    <Setter Property="Foreground" Value="#B2C0D2" />
    <Setter Property="Padding" Value="8,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" Background="#121C2A" BorderBrush="Transparent" BorderThickness="1,1,1,2"
                  CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="1,0">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="#1C2B3D" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="#78E0C4" />
              <Setter Property="Foreground" Value="#EDF2FA" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="#EDF2FA" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PortraitSwitch" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="#EDF2FA" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Padding="2,4">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Track" Width="38" Height="20" Background="#26374A" BorderBrush="#899BB2" BorderThickness="1" CornerRadius="10">
                <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0" Fill="#D5DFEC" HorizontalAlignment="Left" />
              </Border>
              <ContentPresenter ContentSource="Content" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#78E0C4" />
              <Setter TargetName="Track" Property="BorderBrush" Value="#78E0C4" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Thumb" Property="Fill" Value="#11231F" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="#EDF2FA" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="#EDF2FA" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ProfileListExpander" TargetType="Expander">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="HeaderSite" Margin="0" Padding="9,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{TemplateBinding Header}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Heading" Background="#1B2737" BorderBrush="Transparent" BorderThickness="1"
                          CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Heading" Property="Background" Value="#243449" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Heading" Property="BorderBrush" Value="#78E0C4" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <DockPanel TextElement.Foreground="#EDF2FA">
                <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M0,0 L4,4 8,0" Stroke="#A6B5C9" StrokeThickness="1.3" Margin="8,0,0,0"
                      VerticalAlignment="Center" />
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
              </DockPanel>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Grid.Row="1" ContentSource="Content" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              <Setter TargetName="Chevron" Property="Data" Value="M0,4 L4,0 8,4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ProfileListItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="6" Margin="0,0,0,2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="#1C2B3D" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="#1B3745" />
              <Setter TargetName="Row" Property="BorderBrush" Value="#4A8C8A" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="#78E0C4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AboutLink" TargetType="Button">
    <Setter Property="Foreground" Value="#A6B5C9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="LinkSurface" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="1">
            <ContentPresenter RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="#78E0C4" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="LinkSurface" Property="BorderBrush" Value="#78E0C4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
