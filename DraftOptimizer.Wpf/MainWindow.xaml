<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DraftOptimizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DraftOptimizer" xmlns:core="clr-namespace:DraftOptimizer.Core;assembly=DraftOptimizer.Core" Title="DraftOptimizer" Background="#0A1019" Width="1100" Height="850" MinWidth="940" MinHeight="650" Icon="DraftOptimizer.ico" TextElement.Foreground="#EDF2FA">
  <Grid x:Name="Root" Margin="20" Background="#0A1019" Loaded="OnLoaded">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="Interface.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="RuneChoiceTemplate">
          <StackPanel Orientation="Horizontal">
            <local:PortraitImage Width="28" Height="28" Url="{Binding IconUrl}" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ChampionRowsPanel">
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ChampionPortraitsPanel">
          <WrapPanel ItemWidth="126" ItemHeight="154" />
        </ItemsPanelTemplate>
        <Style x:Key="ChampionContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="3" />
        </Style>
        <DataTemplate x:Key="ChampionRowTemplate">
          <Grid Margin="8" Background="#131E2C">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Content="{Binding FavoriteStar}" Click="FavoriteStarClick" IsEnabled="{Binding CanChangeFavorites}" AutomationProperties.Name="{Binding FavoriteAction}" ToolTipService.ToolTip="{Binding FavoriteAction}" FontSize="23" Foreground="#FFD166" Background="Transparent" BorderThickness="0" Padding="0" Width="36" Height="36" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Champion.Name}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#B2C0D2" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ChampionPortraitTemplate">
          <Grid Width="116" Height="144" Margin="6" Background="#131E2C">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"
                  ToolTip="{Binding ConfidenceTooltip}" AutomationProperties.Name="{Binding ConfidenceTooltip}">
              <Border BorderBrush="{Binding ConfidenceColor}" BorderThickness="2">
                <local:PortraitImage Width="72" Height="72" Url="{Binding PortraitUrl}" Stretch="UniformToFill" />
              </Border>
              <Border Background="{Binding ConfidenceColor}" CornerRadius="0,0,0,5" Padding="5,1"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding ConfidenceRank}" Foreground="#101923" FontSize="10" FontWeight="Bold" />
              </Border>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Champion.Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,5,0,0" />
            <Button Grid.Row="2" Content="{Binding FavoriteStar}" Click="FavoriteStarClick" IsEnabled="{Binding CanChangeFavorites}" AutomationProperties.Name="{Binding FavoriteAction}" HorizontalAlignment="Center" Foreground="#FFD166" Background="Transparent" BorderThickness="0" Padding="2" FontSize="20" />
          </Grid>
        </DataTemplate>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Margin" Value="0,2,6,2" />
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
          <Setter Property="MinHeight" Value="28" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#121C2A" CornerRadius="14" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Image Source="DraftOptimizerIcon.png" Width="48" Height="48" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="DRAFT OPTIMIZER" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="Elige con confianza. Prepara tu partida." Foreground="#A6B5C9" FontSize="13" Margin="0,5,0,0" />
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#0D2B29" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
            <TextBlock x:Name="ConnectionText" Text="Buscando League…" Foreground="#78E0C4" FontSize="12" VerticalAlignment="Center" />
          </Border>
          <Button Content="Conectar" Click="ConnectClick" />
          <Button Content="Ruta de League" Click="LockfileClick" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="Notice" Grid.Row="1" Background="#182838" CornerRadius="8" Padding="12,5" Margin="0,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" Click="DismissNotice" AutomationProperties.Name="Cerrar aviso" />
        <StackPanel>
          <TextBlock x:Name="NoticeTitle" FontWeight="SemiBold" Text="Preparando datos" />
          <TextBlock x:Name="NoticeMessage" Text="Puedes crear perfiles sin tener League abierto." TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl x:Name="MainTabs" Style="{StaticResource DraftTabs}" ItemContainerStyle="{StaticResource DraftTab}" Grid.Row="2" Margin="0,2,0,0" SelectionChanged="MainTabChanged">
      <TabItem Header="Campeones">
        <Grid Margin="4,10,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
          </Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,3,8,3">
                <TextBlock Text="Línea" Margin="0,0,0,3" />
                <ListBox x:Name="RoleBox" SelectionChanged="FiltersChanged" AutomationProperties.Name="Línea"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="0,5,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                      <Border Background="Transparent"><ItemsPresenter /></Border>
                    </ControlTemplate>
                  </ListBox.Template>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5" /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="ToolTip" Value="{Binding}" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                      <Setter Property="Foreground" Value="#A6B5C9" />
                      <Setter Property="Background" Value="#111D2A" />
                      <Setter Property="BorderBrush" Value="#29384B" />
                      <Setter Property="Margin" Value="1,0" />
                      <Setter Property="Padding" Value="3,7" />
                      <Setter Property="HorizontalContentAlignment" Value="Center" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#78E0C4" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#EDF2FA" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter Property="Foreground" Value="#78E0C4" />
                          <Setter Property="Background" Value="#17382F" />
                          <Setter Property="BorderBrush" Value="#78E0C4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                      </Style.Triggers>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Path Width="18" Height="18" Stretch="Uniform"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                        <Path.Style>
                          <Style TargetType="Path">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding}" Value="{x:Static core:Role.Top}">
                                <Setter Property="Data" Value="M1,1 H23 V7 H7 V23 H1 Z M10,10 H22 V22 H10 Z" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding}" Value="{x:Static core:Role.Jungle}">
                                <Setter Property="Data" Value="M3,1 L10,9 L11,15 L8,12 L3,8 Z M21,1 L14,9 L13,15 L16,12 L21,8 Z M1,10 L8,16 L12,23 L16,16 L23,10 L21,19 L12,26 L3,19 Z" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding}" Value="{x:Static core:Role.Middle}">
                                <Setter Property="Data" Value="M1,1 H13 L8,6 H6 V8 L1,13 Z M23,23 H11 L16,18 H18 V16 L23,11 Z M1,19 L19,1 H24 V6 L6,24 H1 Z" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding}" Value="{x:Static core:Role.Bottom}">
                                <Setter Property="Data" Value="M1,17 H17 V1 H23 V23 H1 Z M2,2 H14 V14 H2 Z" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding}" Value="{x:Static core:Role.Support}">
                                <Setter Property="Data" Value="M9,1 H15 L17,5 L12,10 L7,5 Z M1,6 L9,10 L12,14 L15,10 L23,6 L20,14 L15,16 L14,23 H10 L9,16 L4,14 Z" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Path.Style>
                      </Path>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,3,8,3">
                <TextBlock Text="Buscar campeón" Margin="0,0,0,3" />
                <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="Buscar campeón" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="0,4,0,8" Background="#111B28" CornerRadius="10" Padding="12,9">
              <StackPanel>
                <TextBlock x:Name="ChampionDraftSummary" Text="WR del draft: esperando selección." Foreground="#7DE0C5" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="ChampionLoadoutSummary" Text="Configuración automática: esperando campeón confirmado." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="PortraitToggle" Style="{StaticResource PortraitSwitch}" Content="Retratos" IsChecked="True" Checked="PortraitToggled" Unchecked="PortraitToggled" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="★ Favoritos primero · confianza estadística" ToolTipService.ToolTip="Sin picks: WR y partidas de la línea. Con picks: límite conservador del draft." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" />
              </Grid>
              <ListBox x:Name="SuggestionsList" Background="#0D1520" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="1" SelectionChanged="SuggestionChanged" SelectionMode="Single" ItemTemplate="{StaticResource ChampionRowTemplate}" ItemsPanel="{StaticResource ChampionRowsPanel}" ItemContainerStyle="{StaticResource ChampionContainerStyle}" />
            </Grid>
            <Border Grid.Row="3" Margin="0,8,0,0" Background="#111B28" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox Grid.ColumnSpan="3" x:Name="ChampionBox" SelectionChanged="ChampionChanged" AutomationProperties.Name="Campeón seleccionado" />
                <Button x:Name="HoverButton" Grid.Row="1" Grid.Column="1" Content="Preseleccionar" Click="HoverClick" IsEnabled="False" Margin="0,8,6,0" />
                <Button x:Name="LockButton" Grid.Row="1" Grid.Column="2" Content="Confirmar pick" Click="LockClick" IsEnabled="False" Margin="0,8,0,0" />
              </Grid>
            </Border>
          </Grid>
          <Border Grid.Column="1" Margin="10,0,0,0" Background="#121C2A" CornerRadius="14" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="PREPARACIÓN" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" />
                <TextBlock x:Name="PreviewTitle" Text="Selecciona un campeón" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock x:Name="PreviewState" Text="Al confirmar se aplicará tu perfil o la recomendación de Lolalytics." FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock x:Name="PreviewSource" FontSize="11" Foreground="#A6B5C9" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Border Height="1" Background="#29384B" Margin="0,5,0,0" />
                <TextBlock Text="Elige runas y build" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock x:Name="BuildOptionsStatus" Text="Selecciona un campeón para comparar opciones." FontSize="12" Foreground="#A6B5C9" TextWrapping="Wrap" Margin="0,5,0,0" />
                <RadioButton x:Name="PopularBuildOption" GroupName="DraftBuildOption" Visibility="Collapsed" Checked="BuildOptionChanged" Margin="0,5,0,0" />
                <RadioButton x:Name="HighWinrateBuildOption" GroupName="DraftBuildOption" Visibility="Collapsed" Checked="BuildOptionChanged" Margin="0,5,0,0" />
                <TextBlock x:Name="PersonalBuildOptionsTitle" Text="Mis perfiles" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,5,0,0" />
                <StackPanel x:Name="PersonalBuildOptions" Margin="0,5,0,0" />
                <Border Height="1" Background="#29384B" Margin="0,5,0,0" />
                <TextBlock Text="Runas seleccionadas" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock x:Name="PreviewRunes" Text="Sin configuración cargada" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="Hechizos de invocador" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock x:Name="PreviewSpells" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                <TextBlock Text="Habilidades y objetos" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock x:Name="PreviewItems" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Button Content="Abrir en el editor" Click="PreviewEditClick" HorizontalAlignment="Left" Margin="0,5,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="LoadoutTab" Header="Runas y objetos">
        <Grid Margin="4,10,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="#121C2A" CornerRadius="14" Padding="12">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Nuevo perfil" Click="NewClick" Margin="0,8,0,0" />
              <Expander Header="Configuraciones guardadas" IsExpanded="True" Style="{StaticResource ProfileListExpander}">
                <Grid Margin="0,6,0,0">
                  <ListBox x:Name="ProfilesBox" SelectionChanged="ProfileChanged"
                           AutomationProperties.Name="Configuraciones guardadas"
                           Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ProfileListItem}"
                           HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EDF2FA" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Role}" FontSize="11" Foreground="#A6B5C9" Margin="0,2,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="Todavía no hay perfiles guardados." TextWrapping="Wrap"
                             Foreground="#A6B5C9" Margin="8" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasItems, ElementName=ProfilesBox}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Expander>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="#121C2A" CornerRadius="14" Padding="18" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="PERFILES Y AUTOMATIZACIÓN" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" />
                  <TextBlock Text="Runas y ruta de objetos" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <Expander Header="Cuenta y sincronización en la nube" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,5,0,0">
                  <StackPanel Margin="4,10,4,4">
                    <TextBlock x:Name="CloudSyncStatus" Text="Sin sesión · los cambios se guardan en este equipo." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" />
                    <Grid Margin="0,5,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,3,8,3">
                        <TextBlock Text="Correo" Margin="0,0,0,3" />
                        <TextBox x:Name="FirebaseEmailBox" AutomationProperties.Name="Correo" Margin="0,5,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,3,8,3">
                        <TextBlock Text="Contraseña" Margin="0,0,0,3" />
                        <PasswordBox x:Name="FirebasePasswordBox" AutomationProperties.Name="Contraseña" Margin="0,5,0,0" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <Button x:Name="FirebaseSignInButton" Content="Iniciar sesión" Click="FirebaseSignInClick" />
                      <Button x:Name="FirebaseRegisterButton" Content="Crear cuenta" Click="FirebaseRegisterClick" />
                      <Button x:Name="FirebaseSignOutButton" Content="Cerrar sesión" Click="FirebaseSignOutClick" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="FirebaseImportLocalButton" Content="Importar la configuración local a esta cuenta" Click="FirebaseImportLocalClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,5,0,0" />
                    <TextBlock Text="Favoritos, automatización y perfiles de runas/objetos se sincronizan automáticamente. La configuración de League y la caché de estadísticas permanecen en este equipo." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Favoritos y selección automática" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,5,0,0">
                  <StackPanel Margin="4,10,4,4">
                    <TextBlock Text="Marca ★ junto a un campeón para guardarlo como favorito de esa línea." TextWrapping="Wrap" FontSize="12" />
                    <Button Content="Importar favoritos de League" Click="ImportLeagueFavoritesClick" HorizontalAlignment="Left" Margin="0,5,0,0" />
                    <TextBlock x:Name="FavoritesText" Text="Cargando favoritos…" Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                    <CheckBox x:Name="AutoHoverBox" Content="Preseleccionar la mejor opción (favoritos primero)" Checked="AutomationChanged" Unchecked="AutomationChanged" Margin="0,5,0,0" />
                    <CheckBox x:Name="AutoLockBox" Content="Confirmar automáticamente cerca del final del turno" Checked="AutomationChanged" Unchecked="AutomationChanged" Margin="0,5,0,0" />
                    <StackPanel Margin="0,3,8,3">
                      <TextBlock Text="Segundos restantes para confirmar" Margin="0,0,0,3" />
                      <DockPanel x:Name="AutoLockSecondsControl" HorizontalAlignment="Left" Margin="0,3,0,0">
                        <RepeatButton DockPanel.Dock="Right" Width="28" Content="+" Click="IncreaseSeconds" Focusable="False" AutomationProperties.Name="Aumentar segundos" />
                        <RepeatButton DockPanel.Dock="Right" Width="28" Content="−" Click="DecreaseSeconds" Focusable="False" AutomationProperties.Name="Reducir segundos" />
                        <TextBox x:Name="AutoLockSecondsBox" Width="56" Text="1" MaxLength="2" HorizontalContentAlignment="Center" LostKeyboardFocus="CommitSecondsOnBlur" PreviewKeyDown="SecondsKeyDown" AutomationProperties.Name="Segundos restantes para confirmar" />
                      </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="AutomationText" Text="Esperando tu turno de selección." Foreground="#78E0C4" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                    <TextBlock Text="La prioridad combina winrate, confianza por partidas y composición. El puntaje orienta la elección, no predice el resultado de la partida." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                    <CheckBox x:Name="AutoLoadoutBox" Content="Aplicar hechizos, runas y objetos al confirmar campeón" Checked="AutomationChanged" Unchecked="AutomationChanged" Margin="0,5,0,0" />
                    <StackPanel Margin="0,5,0,0">
                      <Label Content="Tecla de Destello al aplicar hechizos" Target="{Binding ElementName=FlashKeyBox}" Padding="0,0,0,3" />
                      <ComboBox x:Name="FlashKeyBox" SelectedValuePath="Tag" SelectionChanged="FlashKeyChanged" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Según la build" Tag="{x:Static core:FlashKey.Profile}" />
                        <ComboBoxItem Content="D" Tag="{x:Static core:FlashKey.D}" />
                        <ComboBoxItem Content="F" Tag="{x:Static core:FlashKey.F}" />
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <Button Content="Reintentar configuración" Click="RetryLoadoutClick" />
                      <Button Content="Ver configuración preparada" Click="ViewPreparedClick" />
                    </StackPanel>
                  </StackPanel>
                </Expander>
                <Border Height="1" Background="#29384B" Margin="0,5,0,0" />
                <WrapPanel Margin="0,5,0,0">
                  <Button Content="Cargar build de Lolalytics" Click="LolalyticsClick" />
                  <Button Content="Abrir Lolalytics ↗" Click="OpenLolalyticsClick" />
                </WrapPanel>
                <TextBlock x:Name="SourceText" Text="Perfil personalizado" Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,3,8,3">
                    <TextBlock Text="Campeón" Margin="0,0,0,3" />
                    <ComboBox x:Name="ProfileChampionBox" SelectionChanged="ProfileEditorChanged" AutomationProperties.Name="Campeón" Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,3,0,3">
                    <TextBlock Text="Línea" Margin="0,0,0,3" />
                    <ComboBox x:Name="ProfileRoleBox" SelectionChanged="ProfileEditorChanged" AutomationProperties.Name="Línea" Margin="0,5,0,0" />
                  </StackPanel>
                </Grid>
                <StackPanel Margin="0,3,8,3">
                  <TextBlock Text="Nombre del perfil" Margin="0,0,0,3" />
                  <TextBox x:Name="ProfileName" Text="Mi configuración" TextChanged="ProfileNameChanged" AutomationProperties.Name="Nombre del perfil" Margin="0,5,0,0" />
                </StackPanel>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Background="#101A27" CornerRadius="10" Padding="12">
                    <StackPanel>
                      <StackPanel Margin="0,3,8,3">
                        <TextBlock Text="Rama primaria" Margin="0,0,0,3" />
                        <ComboBox x:Name="PrimaryBox" ItemTemplate="{StaticResource RuneChoiceTemplate}" SelectionChanged="PrimaryChanged" AutomationProperties.Name="Rama primaria" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Text="Runas principales · una por fila" Foreground="#A6B5C9" TextWrapping="Wrap" Margin="0,5,0,0" />
                      <StackPanel x:Name="PrimaryRuneGrid" Margin="0,5,0,0" />
                      <StackPanel Visibility="Collapsed" Margin="0,5,0,0">
                        <ComboBox x:Name="P0" SelectionChanged="ProfileRuneChanged" />
                        <ComboBox x:Name="P1" SelectionChanged="ProfileRuneChanged" />
                        <ComboBox x:Name="P2" SelectionChanged="ProfileRuneChanged" />
                        <ComboBox x:Name="P3" SelectionChanged="ProfileRuneChanged" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#101A27" CornerRadius="10" Padding="12">
                    <StackPanel>
                      <StackPanel Margin="0,3,8,3">
                        <TextBlock Text="Rama secundaria" Margin="0,0,0,3" />
                        <ComboBox x:Name="SecondaryBox" ItemTemplate="{StaticResource RuneChoiceTemplate}" SelectionChanged="SecondaryChanged" AutomationProperties.Name="Rama secundaria" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Text="Runas secundarias · elige dos filas" Foreground="#A6B5C9" TextWrapping="Wrap" Margin="0,5,0,0" />
                      <StackPanel x:Name="SecondaryRuneGrid" Margin="0,5,0,0" />
                      <StackPanel Visibility="Collapsed" Margin="0,5,0,0">
                        <ComboBox x:Name="S0" SelectionChanged="ProfileRuneChanged" />
                        <ComboBox x:Name="S1" SelectionChanged="ProfileRuneChanged" />
                      </StackPanel>
                      <TextBlock Text="Fragmentos" Foreground="#A6B5C9" Margin="0,5,0,0" />
                      <ComboBox x:Name="F0" SelectionChanged="ProfileRuneChanged" Margin="0,5,0,0" />
                      <ComboBox x:Name="F1" SelectionChanged="ProfileRuneChanged" Margin="0,5,0,0" />
                      <ComboBox x:Name="F2" SelectionChanged="ProfileRuneChanged" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Hechizo de invocador · D" Margin="0,0,0,4" />
                    <ComboBox x:Name="Spell1Box" DisplayMemberPath="Name" SelectionChanged="ProfileEditorChanged"
                              AutomationProperties.Name="Hechizo de invocador D" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Hechizo de invocador · F" Margin="0,0,0,4" />
                    <ComboBox x:Name="Spell2Box" DisplayMemberPath="Name" SelectionChanged="ProfileEditorChanged"
                              AutomationProperties.Name="Hechizo de invocador F" />
                  </StackPanel>
                </Grid>
                <StackPanel Margin="0,3,8,3">
                  <TextBlock Text="Ruta de compra · bloques y objetos en varias líneas" Margin="0,0,0,3" />
                  <TextBox x:Name="ItemsText" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap" TextChanged="ItemsTextChanged" AutomationProperties.Name="Ruta de compra · bloques y objetos en varias líneas" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="Escribe el nombre de cada bloque y debajo sus IDs. Repite un ID para indicar cantidad." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Margin="0,3,8,3">
                      <TextBlock Text="Buscar objeto por nombre o ID" Margin="0,0,0,3" />
                      <TextBox x:Name="ItemSearch" TextChanged="ItemSearchChanged" PreviewKeyDown="ItemSearchKeyDown" AutomationProperties.Name="Buscar objeto por nombre o ID" Margin="0,5,0,0" />
                    </StackPanel>
                    <Popup x:Name="ItemSuggestions" Placement="Bottom" PlacementTarget="{Binding ElementName=ItemSearch}" StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=ItemSearch}">
                      <ListBox x:Name="ItemMatches" MaxHeight="220" MinWidth="220" Focusable="False" KeyboardNavigation.TabNavigation="None" PreviewMouseLeftButtonUp="ItemSuggestionClicked" AutomationProperties.Name="Objetos encontrados" />
                    </Popup>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Añadir" Click="AddItemClick" VerticalAlignment="Bottom" />
                </Grid>
                <WrapPanel Margin="0,5,0,0">
                  <Button Content="Guardar ahora" Click="SaveClick" />
                  <Button Content="Importar / exportar JSON" Click="JsonClick" />
                  <Button Content="Importar archivo JSON" Click="ImportJsonFileClick" />
                  <Button Content="Eliminar perfil" Click="DeleteClick" />
                </WrapPanel>
                <TextBlock x:Name="ProfileSaveStatus" Text="Los cambios del perfil se guardan automáticamente en este equipo." Foreground="#A6B5C9" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Border Height="1" Background="#29384B" Margin="0,5,0,0" />
                <WrapPanel Margin="0,5,0,0">
                  <Button Content="Aplicar hechizos a League" Click="ImportSummonerSpellsClick" />
                  <Button Content="Aplicar runas a League" Click="ImportRunesClick" />
                  <Button Content="Enviar objetos a League" Click="ImportItemsClick" />
                </WrapPanel>
                <TextBlock Text="Las runas usan una página llamada DraftOptimizer. Los objetos aparecen como un conjunto recomendado dentro del juego." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Baneos prioritarios">
        <Grid Margin="4,10,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="#121C2A" CornerRadius="14" Padding="18" Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="BANEOS POR LÍNEA" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" />
                <TextBlock Text="Define tus prioridades" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="El sistema omite cualquier campeón que un compañero tenga preseleccionado." Foreground="#A6B5C9" TextWrapping="Wrap" Margin="0,5,0,0" />
                <CheckBox x:Name="AutoBanBox" Checked="AutomationChanged" Unchecked="AutomationChanged" Margin="0,5,0,0">
                  <TextBlock Text="Banear automáticamente al comenzar tu turno" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Margin="0,3,8,3">
                  <TextBlock Text="Línea" Margin="0,0,0,3" />
                  <ComboBox x:Name="BanRoleBox" SelectionChanged="BanRoleChanged" AutomationProperties.Name="Línea" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Margin="0,3,8,3">
                  <TextBlock Text="Campeón para añadir" Margin="0,0,0,3" />
                  <ComboBox x:Name="BanChampionBox" AutomationProperties.Name="Campeón para añadir" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="Añadir a prioridades" Click="AddBanPriorityClick" HorizontalAlignment="Left" Margin="0,5,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="1" Background="#121C2A" CornerRadius="14" Padding="18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="ORDEN DE PRIORIDAD" FontSize="16" FontWeight="SemiBold" />
              <ListView Grid.Row="1" x:Name="BanPriorityList" SelectionMode="Single" AutomationProperties.Name="Prioridad de baneos" Margin="0,5,0,0" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="Subir" Click="MoveBanPriorityUpClick" />
                <Button Content="Bajar" Click="MoveBanPriorityDownClick" />
                <Button Content="Quitar" Click="RemoveBanPriorityClick" />
              </StackPanel>
              <TextBlock Grid.Row="3" x:Name="BanStatusText" Text="Configura una lista para cada línea." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="SimulationTab" Header="Simulación">
        <Grid Margin="4,10,4,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="#121C2A" CornerRadius="12" Padding="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,3,8,3">
                <TextBlock Text="Línea" Margin="0,0,0,3" />
                <ComboBox x:Name="SimulationRoleBox" VerticalAlignment="Bottom" SelectionChanged="SimulationRoleChanged" AutomationProperties.Name="Línea" Margin="0,5,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,3,8,3">
                <TextBlock Text="Buscar campeón" Margin="0,0,0,3" />
                <TextBox x:Name="SimulationSearchBox" TextChanged="SimulationSearchChanged" AutomationProperties.Name="Buscar campeón" Margin="0,5,0,0" />
              </StackPanel>
              <ToggleButton x:Name="SimulationPortraitToggle" Style="{StaticResource PortraitSwitch}" Grid.Column="2" Content="Retratos" Checked="SimulationPortraitToggled" Unchecked="SimulationPortraitToggled" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <TextBlock x:Name="SimulationTurnText" Grid.Row="1" TextWrapping="Wrap" />
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Background="#11231F" CornerRadius="10" Margin="12">
              <TextBlock x:Name="SimulationBlueText" TextWrapping="Wrap" />
            </Border>
            <Border Grid.Column="1" Background="#251820" CornerRadius="10" Padding="12">
              <TextBlock x:Name="SimulationRedText" TextWrapping="Wrap" />
            </Border>
          </Grid>
          <ListBox x:Name="SimulationCandidates" Background="#0D1520" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="3" Margin="0,8" SelectionMode="Single" ItemTemplate="{StaticResource ChampionRowTemplate}" ItemsPanel="{StaticResource ChampionRowsPanel}" ItemContainerStyle="{StaticResource ChampionContainerStyle}" />
          <Border Grid.Row="4" Background="#121C2A" CornerRadius="12" Padding="12">
            <StackPanel>
              <TextBlock x:Name="SimulationMetricText" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button x:Name="SimulationPickButton" Content="Confirmar pick simulado" Click="SimulationPickClick" />
                <Button Content="Deshacer" Click="SimulationUndoClick" />
                <Button Content="Reiniciar" Click="SimulationResetClick" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Estado del draft">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4">
          <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="ESTADO Y COMPOSICIÓN" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" />
            <Border Background="#121C2A" CornerRadius="14" Padding="18" Margin="0,5,0,0">
              <StackPanel>
                <TextBlock x:Name="DraftText" Text="Abre League para sincronizar la selección." TextWrapping="Wrap" FontSize="16" />
                <TextBlock x:Name="DraftWinrateText" Text="WR del draft: esperando selección." Foreground="#78E0C4" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,0" />
                <Expander HorizontalContentAlignment="Stretch" Header="Composición y posiciones" HorizontalAlignment="Stretch" Margin="0,5,0,0">
                  <TextBlock x:Name="TeamsText" Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" />
                </Expander>
                <TextBlock x:Name="AutomationSummary" Text="Auto: sin favoritos configurados." Foreground="#78E0C4" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                <TextBlock x:Name="LoadoutStatus" Text="Runas y objetos: esperando campeón confirmado." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                <CheckBox x:Name="FollowBox" Content="Seguir mi campeón y posición del cliente" IsChecked="True" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="DataText" Text="Cargando catálogo…" Foreground="#899BB2" FontSize="11" TextTrimming="CharacterEllipsis" />
        <Button Style="{StaticResource AboutLink}" Content="Acerca de · proyecto independiente de Riot Games" Click="AboutClick" FontSize="11" Margin="0" HorizontalAlignment="Left" />
      </StackPanel>
      <Button Grid.Column="1" Content="Actualizar datos" Click="RefreshClick" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>