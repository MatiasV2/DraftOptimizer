<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>DraftOptimizer</RootNamespace>
    <AssemblyName>DraftOptimizer</AssemblyName>
    <ApplicationIcon>DraftOptimizer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DraftOptimizer.Core\DraftOptimizer.Core.csproj" />
    <Resource Include="DraftOptimizer.ico" />
    <Content Include="Data\current-patch.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
