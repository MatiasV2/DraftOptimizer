<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DraftOptimizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:DraftOptimizer" Title="DraftOptimizer">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark" Padding="20" RowSpacing="14" Background="#0A1019" Loaded="OnLoaded">
    <Grid.Resources>
      <local:PortraitImageConverter x:Key="PortraitImageConverter" />
      <local:ProfileChampionConverter x:Key="ProfileChampionConverter" />
      <DataTemplate x:Key="RuneChoiceTemplate"><StackPanel Orientation="Horizontal" Spacing="9"><Image Width="28" Height="28" Source="{Binding IconUrl, Converter={StaticResource PortraitImageConverter}}" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate>
      <ItemsPanelTemplate x:Key="ChampionRowsPanel"><ItemsStackPanel CacheLength="1" /></ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="ChampionPortraitsPanel"><ItemsWrapGrid CacheLength="1" ItemWidth="126" ItemHeight="154" Orientation="Horizontal" /></ItemsPanelTemplate>
      <Style x:Key="ChampionContainerStyle" TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Padding" Value="3" /></Style>
      <DataTemplate x:Key="ChampionRowTemplate">
        <Grid Padding="8" ColumnSpacing="10" Background="#131E2C" CornerRadius="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button Content="{Binding FavoriteStar}" Click="FavoriteStarClick" IsEnabled="{Binding CanChangeFavorites}" AutomationProperties.Name="{Binding FavoriteAction}" ToolTipService.ToolTip="{Binding FavoriteAction}" FontSize="23" Foreground="#FFD166" Background="Transparent" BorderThickness="0" Padding="0" Width="36" Height="36" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Champion.Name}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#B2C0D2" TextWrapping="Wrap" /></StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ChampionPortraitTemplate">
        <Grid Width="116" Height="144" Padding="6" Background="#131E2C" CornerRadius="10">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Image Width="72" Height="72" Source="{Binding PortraitUrl, Converter={StaticResource PortraitImageConverter}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Text="{Binding Champion.Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,5,0,0" />
          <Button Grid.Row="2" Content="{Binding FavoriteStar}" Click="FavoriteStarClick" IsEnabled="{Binding CanChangeFavorites}" AutomationProperties.Name="{Binding FavoriteAction}" HorizontalAlignment="Center" Foreground="#FFD166" Background="Transparent" BorderThickness="0" Padding="2" FontSize="20" />
        </Grid>
      </DataTemplate>
      <Style TargetType="Button"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="12,7" /></Style>
      <Style TargetType="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#121C2A" CornerRadius="14" Padding="18,14">
      <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><Image x:Name="BrandLogo" Width="48" Height="48" VerticalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="DRAFT OPTIMIZER" FontSize="21" FontWeight="Bold" CharacterSpacing="110" /><TextBlock Text="Elige con confianza. Prepara tu partida." Foreground="#A6B5C9" FontSize="13" /></StackPanel></Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#0D2B29" CornerRadius="8" Padding="10,7" VerticalAlignment="Center"><TextBlock x:Name="ConnectionText" Text="Buscando League…" Foreground="#78E0C4" FontSize="12" VerticalAlignment="Center" /></Border>
          <Button Content="Conectar" Click="ConnectClick" /><Button Content="Ruta de League" Click="LockfileClick" />
        </StackPanel>
      </Grid>
    </Border>

    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="True" IsClosable="True" Severity="Informational" Title="Preparando datos" Message="Puedes crear perfiles sin tener League abierto." />

    <TabView x:Name="MainTabs" Grid.Row="2" Margin="0,2,0,0" SelectionChanged="MainTabChanged" IsAddTabButtonVisible="False" TabWidthMode="Equal">
      <TabViewItem IsClosable="False" Header="Campeones">
        <Grid ColumnSpacing="14" Padding="4,10,4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
          <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <ComboBox x:Name="RoleBox" Header="Línea / modo" SelectionChanged="FiltersChanged" />
              <TextBox x:Name="SearchBox" Grid.Column="1" Header="Buscar campeón" PlaceholderText="Nombre del campeón…" TextChanged="SearchChanged" />
            </Grid>
            <Border Grid.Row="1" Background="#111B28" CornerRadius="10" Padding="12,9"><StackPanel Spacing="4">
              <TextBlock x:Name="ChampionDraftSummary" Text="WR del draft: esperando selección." Foreground="#7DE0C5" FontSize="13" TextWrapping="Wrap" />
              <TextBlock x:Name="ChampionLoadoutSummary" Text="Configuración automática: esperando campeón confirmado." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" />
            </StackPanel></Border>
            <Grid Grid.Row="2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <ToggleSwitch x:Name="PortraitToggle" Header="Retratos" IsOn="True" Toggled="PortraitToggled" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="★ Favoritos primero · confianza estadística" ToolTipService.ToolTip="Sin picks: WR y partidas de la línea. Con picks: límite conservador del draft." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" />
              </Grid>
              <GridView x:Name="SuggestionsList" Grid.Row="1" SelectionChanged="SuggestionChanged" SelectionMode="Single" ItemTemplate="{StaticResource ChampionRowTemplate}" ItemsPanel="{StaticResource ChampionRowsPanel}" ItemContainerStyle="{StaticResource ChampionContainerStyle}"><GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions></GridView>
            </Grid>
            <Border Grid.Row="3" Background="#111B28" CornerRadius="10" Padding="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ComboBox Grid.ColumnSpan="3" x:Name="ChampionBox" SelectionChanged="ChampionChanged" AutomationProperties.Name="Campeón seleccionado" PlaceholderText="Campeón seleccionado" />
              <Button x:Name="HoverButton" Grid.Row="1" Grid.Column="1" Content="Preseleccionar" Click="HoverClick" IsEnabled="False" Margin="0,8,0,0" />
              <Button x:Name="LockButton" Grid.Row="1" Grid.Column="2" Content="Confirmar pick" Click="LockClick" IsEnabled="False" Margin="0,8,0,0" />
            </Grid></Border>
          </Grid>

          <Border Grid.Column="1" Background="#121C2A" CornerRadius="14" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="11">
            <TextBlock Text="PREPARACIÓN" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" CharacterSpacing="120" />
            <TextBlock x:Name="PreviewTitle" Text="Selecciona un campeón" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewState" Text="Al confirmar se aplicará tu perfil o la recomendación de Lolalytics." FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewSource" FontSize="11" Foreground="#A6B5C9" TextWrapping="Wrap" />
            <Border Height="1" Background="#29384B" />
            <TextBlock Text="Elige runas y build" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="BuildOptionsStatus" Text="Selecciona un campeón para comparar opciones." FontSize="12" Foreground="#A6B5C9" TextWrapping="Wrap" />
            <RadioButton x:Name="PopularBuildOption" GroupName="DraftBuildOption" Visibility="Collapsed" Checked="BuildOptionChanged" />
            <RadioButton x:Name="HighWinrateBuildOption" GroupName="DraftBuildOption" Visibility="Collapsed" Checked="BuildOptionChanged" />
            <TextBlock x:Name="PersonalBuildOptionsTitle" Text="Mis perfiles" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" />
            <StackPanel x:Name="PersonalBuildOptions" Spacing="4" />
            <Border Height="1" Background="#29384B" />
            <TextBlock Text="Runas seleccionadas" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="PreviewRunes" Text="Sin configuración cargada" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="Habilidades y objetos" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="PreviewItems" FontSize="12" TextWrapping="Wrap" />
            <Button Content="Abrir en el editor" Click="PreviewEditClick" HorizontalAlignment="Left" />
          </StackPanel></ScrollViewer></Border>
        </Grid>
      </TabViewItem>

      <TabViewItem x:Name="LoadoutTab" IsClosable="False" Header="Runas y objetos">
        <Border Background="#121C2A" CornerRadius="14" Padding="18" Margin="4,10,4,4"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14" MaxWidth="960" HorizontalAlignment="Left">
          <StackPanel Spacing="4"><TextBlock Text="PERFILES Y AUTOMATIZACIÓN" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" CharacterSpacing="110" /><TextBlock Text="Runas y ruta de objetos" FontSize="24" FontWeight="SemiBold" /></StackPanel>
          <Expander Header="Favoritos y selección automática" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="9" Padding="4,10,4,4"><TextBlock Text="Marca ★ junto a un campeón para guardarlo como favorito de esa línea." TextWrapping="Wrap" FontSize="12" />
              <TextBlock x:Name="FavoritesText" Text="Cargando favoritos…" Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" />
              <CheckBox x:Name="AutoHoverBox" Content="Preseleccionar la mejor opción (favoritos primero)" Checked="AutomationChanged" Unchecked="AutomationChanged" />
              <CheckBox x:Name="AutoLockBox" Content="Confirmar automáticamente cerca del final del turno" Checked="AutomationChanged" Unchecked="AutomationChanged" />
              <NumberBox x:Name="AutoLockSecondsBox" Header="Segundos restantes para confirmar" Minimum="1" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Compact" Value="1" ValueChanged="AutoLockSecondsChanged" />
              <TextBlock x:Name="AutomationText" Text="Esperando tu turno de selección." Foreground="#78E0C4" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="La prioridad combina winrate, confianza por partidas y composición. El puntaje orienta la elección, no predice el resultado de la partida." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" />
              <CheckBox x:Name="AutoLoadoutBox" Content="Aplicar runas y objetos al confirmar campeón" Checked="AutomationChanged" Unchecked="AutomationChanged" />
              <StackPanel Spacing="8" Orientation="Horizontal"><Button Content="Reintentar configuración" Click="RetryLoadoutClick" /><Button Content="Ver configuración preparada" Click="ViewPreparedClick" /></StackPanel>
            </StackPanel>
          </Expander>
          <Border Height="1" Background="#29384B" />
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfilesBox" Header="Mis perfiles" SelectionChanged="ProfileChanged"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding ChampionId, Converter={StaticResource ProfileChampionConverter}}" /><TextBlock Text="{Binding Role}" FontSize="11" Foreground="#A6B5C9" /><TextBlock Text="{Binding Source}" FontSize="10" Foreground="#A6B5C9" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Button Grid.Column="1" Content="Nuevo perfil" Click="NewClick" VerticalAlignment="Bottom" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Cargar Lolalytics D2+" Click="LolalyticsClick" /><Button Content="Abrir Lolalytics ↗" Click="OpenLolalyticsClick" /></StackPanel>
          <TextBlock x:Name="SourceText" Text="Perfil personalizado" Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" />
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileChampionBox" Header="Campeón" /><ComboBox Grid.Column="1" x:Name="ProfileRoleBox" Header="Línea" />
          </Grid>
          <TextBox x:Name="ProfileName" Header="Nombre del perfil" Text="Mi configuración" />
          <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Background="#101A27" CornerRadius="10" Padding="12"><StackPanel Spacing="8"><ComboBox x:Name="PrimaryBox" Header="Rama primaria" ItemTemplate="{StaticResource RuneChoiceTemplate}" SelectionChanged="PrimaryChanged" /><TextBlock Text="Runas principales · una por fila" Foreground="#A6B5C9" TextWrapping="Wrap" /><StackPanel x:Name="PrimaryRuneGrid" Spacing="8" /><StackPanel Visibility="Collapsed"><ComboBox x:Name="P0" /><ComboBox x:Name="P1" /><ComboBox x:Name="P2" /><ComboBox x:Name="P3" /></StackPanel></StackPanel></Border>
            <Border Grid.Column="1" Background="#101A27" CornerRadius="10" Padding="12"><StackPanel Spacing="8"><ComboBox x:Name="SecondaryBox" Header="Rama secundaria" ItemTemplate="{StaticResource RuneChoiceTemplate}" SelectionChanged="SecondaryChanged" /><TextBlock Text="Runas secundarias · elige dos filas" Foreground="#A6B5C9" TextWrapping="Wrap" /><StackPanel x:Name="SecondaryRuneGrid" Spacing="8" /><StackPanel Visibility="Collapsed"><ComboBox x:Name="S0" /><ComboBox x:Name="S1" /></StackPanel><TextBlock Text="Fragmentos" Foreground="#A6B5C9" /><ComboBox x:Name="F0" /><ComboBox x:Name="F1" /><ComboBox x:Name="F2" /></StackPanel></Border>
          </Grid>
          <TextBox x:Name="ItemsText" Header="Ruta de compra · bloques y objetos en varias líneas" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap" PlaceholderText="Inicio:&#xA;1056, 2003, 2003&#xA;Núcleo:&#xA;6655, 3020, 3089" />
          <TextBlock Text="Escribe el nombre de cada bloque y debajo sus IDs. Repite un ID para indicar cantidad." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" />
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><AutoSuggestBox x:Name="ItemSearch" PlaceholderText="Buscar objeto por nombre o ID" TextChanged="ItemSearchChanged" SuggestionChosen="ItemChosen" /><Button Grid.Column="1" Content="Añadir" Click="AddItemClick" /></Grid>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Guardar perfil" Click="SaveClick" /><Button Content="Importar / exportar JSON" Click="JsonClick" /><Button Content="Eliminar perfil" Click="DeleteClick" /></StackPanel>
          <Border Height="1" Background="#29384B" />
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Aplicar runas a League" Click="ImportRunesClick" /><Button Content="Enviar objetos a League" Click="ImportItemsClick" /></StackPanel>
          <TextBlock Text="Las runas usan una página llamada DraftOptimizer. Los objetos aparecen como un conjunto recomendado dentro del juego." Foreground="#A6B5C9" FontSize="12" TextWrapping="Wrap" />
        </StackPanel></ScrollViewer></Border>
      </TabViewItem>

      <TabViewItem IsClosable="False" Header="Baneos prioritarios">
        <Grid ColumnSpacing="16" Padding="4,10,4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="#121C2A" CornerRadius="14" Padding="18"><StackPanel Spacing="12"><TextBlock Text="BANEOS POR LÍNEA" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" CharacterSpacing="110" /><TextBlock Text="Define tus prioridades" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="El sistema omite cualquier campeón que un compañero tenga preseleccionado." Foreground="#A6B5C9" TextWrapping="Wrap" /><CheckBox x:Name="AutoBanBox" Content="Banear automáticamente en el último segundo" Checked="AutomationChanged" Unchecked="AutomationChanged" /><ComboBox x:Name="BanRoleBox" Header="Línea" SelectionChanged="BanRoleChanged" /><ComboBox x:Name="BanChampionBox" Header="Campeón para añadir" /><Button Content="Añadir a prioridades" Click="AddBanPriorityClick" HorizontalAlignment="Left" /></StackPanel></Border>
          <Border Grid.Column="1" Background="#121C2A" CornerRadius="14" Padding="18"><StackPanel Spacing="12"><TextBlock Text="ORDEN DE PRIORIDAD" FontSize="16" FontWeight="SemiBold" /><ListView x:Name="BanPriorityList" Height="360" SelectionMode="Single" AutomationProperties.Name="Prioridad de baneos" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Subir" Click="MoveBanPriorityUpClick" /><Button Content="Bajar" Click="MoveBanPriorityDownClick" /><Button Content="Quitar" Click="RemoveBanPriorityClick" /></StackPanel><TextBlock x:Name="BanStatusText" Text="Configura una lista para cada línea." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" /></StackPanel></Border>
        </Grid>
      </TabViewItem>

      <TabViewItem x:Name="SimulationTab" Header="Simulación" IsClosable="False">
        <Grid Margin="4,10,4,4" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Background="#121C2A" CornerRadius="12" Padding="12"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="SimulationRoleBox" Header="Línea" VerticalAlignment="Bottom" SelectionChanged="SimulationRoleChanged" /><TextBox x:Name="SimulationSearchBox" Grid.Column="1" Header="Buscar campeón" TextChanged="SimulationSearchChanged" /><ToggleSwitch x:Name="SimulationPortraitToggle" Grid.Column="2" Header="Retratos" Toggled="SimulationPortraitToggled" /></Grid></Border>
          <TextBlock x:Name="SimulationTurnText" Grid.Row="1" TextWrapping="Wrap" />
          <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Background="#11231F" CornerRadius="10" Padding="12"><TextBlock x:Name="SimulationBlueText" TextWrapping="Wrap" /></Border><Border Grid.Column="1" Background="#251820" CornerRadius="10" Padding="12"><TextBlock x:Name="SimulationRedText" TextWrapping="Wrap" /></Border></Grid>
          <GridView x:Name="SimulationCandidates" Grid.Row="3" SelectionMode="Single" ItemTemplate="{StaticResource ChampionRowTemplate}" ItemsPanel="{StaticResource ChampionRowsPanel}" ItemContainerStyle="{StaticResource ChampionContainerStyle}" />
          <Border Grid.Row="4" Background="#121C2A" CornerRadius="12" Padding="12"><StackPanel Spacing="8"><TextBlock x:Name="SimulationMetricText" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SimulationPickButton" Content="Confirmar pick simulado" Click="SimulationPickClick" /><Button Content="Deshacer" Click="SimulationUndoClick" /><Button Content="Reiniciar" Click="SimulationResetClick" /></StackPanel></StackPanel></Border>
        </Grid>
      </TabViewItem>

      <TabViewItem IsClosable="False" Header="Estado del draft">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4"><StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="ESTADO Y COMPOSICIÓN" FontSize="12" Foreground="#78E0C4" FontWeight="SemiBold" CharacterSpacing="110" />
          <Border Background="#121C2A" CornerRadius="14" Padding="18"><StackPanel Spacing="12"><TextBlock x:Name="DraftText" Text="Abre League para sincronizar la selección." TextWrapping="Wrap" FontSize="16" /><TextBlock x:Name="DraftWinrateText" Text="WR del draft: esperando selección." Foreground="#78E0C4" TextWrapping="Wrap" FontSize="14" /><Expander HorizontalContentAlignment="Stretch" Header="Composición y posiciones" HorizontalAlignment="Stretch"><TextBlock x:Name="TeamsText" Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" /></Expander><TextBlock x:Name="AutomationSummary" Text="Auto: sin favoritos configurados." Foreground="#78E0C4" TextWrapping="Wrap" FontSize="12" /><TextBlock x:Name="LoadoutStatus" Text="Runas y objetos: esperando campeón confirmado." Foreground="#A6B5C9" TextWrapping="Wrap" FontSize="12" /><CheckBox x:Name="FollowBox" Content="Seguir mi campeón y posición del cliente" IsChecked="True" /></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabViewItem>
    </TabView>

    <Grid Grid.Row="3" ColumnSpacing="16" Margin="2,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="DataText" Text="Cargando catálogo…" Foreground="#899BB2" FontSize="11" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" /><HyperlinkButton Content="Acerca de · proyecto independiente de Riot Games" Click="AboutClick" FontSize="11" Padding="0" HorizontalAlignment="Left" /></StackPanel><Button Grid.Column="1" Content="Actualizar datos" Click="RefreshClick" VerticalAlignment="Center" /></Grid>
  </Grid>
</Window>
