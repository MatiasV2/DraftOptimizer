<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DraftOptimizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:DraftOptimizer" Title="DraftOptimizer">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark" Padding="24" RowSpacing="18" Background="#0C111B" Loaded="OnLoaded">
    <Grid.Resources>
      <local:PortraitImageConverter x:Key="PortraitImageConverter" />
      <DataTemplate x:Key="RuneChoiceTemplate"><StackPanel Orientation="Horizontal" Spacing="8"><Image Width="28" Height="28" Source="{Binding IconUrl, Converter={StaticResource PortraitImageConverter}}" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate>
      <ItemsPanelTemplate x:Key="ChampionRowsPanel"><ItemsStackPanel CacheLength="1" /></ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="ChampionPortraitsPanel"><ItemsWrapGrid CacheLength="1" ItemWidth="116" ItemHeight="142" Orientation="Horizontal" /></ItemsPanelTemplate>
      <Style x:Key="ChampionContainerStyle" TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
      <DataTemplate x:Key="ChampionRowTemplate">
                  <Grid Padding="4,4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding FavoriteStar}" Click="FavoriteStarClick" IsEnabled="{Binding CanChangeFavorites}" AutomationProperties.Name="{Binding FavoriteAction}" ToolTipService.ToolTip="{Binding FavoriteAction}" FontSize="24" Foreground="#FFD166" Background="Transparent" BorderThickness="0" Padding="0" Width="36" Height="36" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Champion.Name}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#94A5BD" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
      <DataTemplate x:Key="ChampionPortraitTemplate"><StackPanel Width="108" Spacing="3" ToolTipService.ToolTip="{Binding Label}"><Image Width="72" Height="72" Source="{Binding PortraitUrl, Converter={StaticResource PortraitImageConverter}}" /><TextBlock Text="{Binding Champion.Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" /><Button Content="{Binding FavoriteStar}" Click="FavoriteStarClick" IsEnabled="{Binding CanChangeFavorites}" AutomationProperties.Name="{Binding FavoriteAction}" HorizontalAlignment="Center" Foreground="#FFD166" /></StackPanel></DataTemplate>

      <local:ProfileChampionConverter x:Key="ProfileChampionConverter" />
      <Style TargetType="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="3">
        <TextBlock Text="DRAFT OPTIMIZER" FontSize="22" FontWeight="SemiBold" CharacterSpacing="100" />
        <TextBlock Text="Tu próximo pick. Tu forma de jugar." Foreground="#94A5BD" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock x:Name="ConnectionText" Text="Buscando League…" VerticalAlignment="Center" Foreground="#6CE0C1" />
        <Button Content="Conectar" Click="ConnectClick" />
        <Button Content="Ruta de League" Click="LockfileClick" />
      </StackPanel>
    </Grid>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="True" IsClosable="True" Severity="Informational" Title="Preparando datos" Message="Puedes crear perfiles sin tener League abierto." />
    <TabView x:Name="MainTabs" SelectionChanged="MainTabChanged" IsAddTabButtonVisible="False" TabWidthMode="Equal" Grid.Row="2">
      <TabViewItem IsClosable="False" Header="Campeones">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
        <Grid RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Spacing="7" Visibility="Collapsed">
            <TextBlock Text="Encuentra tu campeón" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="RoleBox" Header="Posición" SelectionChanged="FiltersChanged" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Header="Campeón" PlaceholderText="Buscar por nombre…" TextChanged="SearchChanged" />
          </Grid>
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Foreground="#6CE0C1" MaxLines="1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="WR del draft: esperando selección." x:Name="ChampionDraftSummary" FontSize="13" />
            <TextBlock Foreground="#94A5BD" MaxLines="1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="Configuración automática: esperando campeón confirmado." x:Name="ChampionLoadoutSummary" FontSize="12" />
          </StackPanel>
          <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><ToggleSwitch x:Name="PortraitToggle" Header="Retratos" Toggled="PortraitToggled" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="★ Favoritos primero · confianza del draft" ToolTipService.ToolTip="Sin picks: confianza del WR y partidas del rol seleccionado. Con picks: límite conservador del draft completo." Foreground="#94A5BD" FontSize="12" TextWrapping="Wrap" /></Grid>
            <GridView x:Name="SuggestionsList" Grid.Row="1" SelectionChanged="SuggestionChanged" SelectionMode="Single" ItemTemplate="{StaticResource ChampionRowTemplate}" ItemsPanel="{StaticResource ChampionRowsPanel}" ItemContainerStyle="{StaticResource ChampionContainerStyle}"><GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions></GridView>
          </Grid>
          <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ComboBox Grid.ColumnSpan="3" x:Name="ChampionBox" SelectionChanged="ChampionChanged" AutomationProperties.Name="Campeón seleccionado" PlaceholderText="Campeón seleccionado" />
            <Button x:Name="HoverButton" Content="Preseleccionar" Click="HoverClick" IsEnabled="False" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" />
            <Button x:Name="LockButton" Content="Confirmar campeón" Click="LockClick" IsEnabled="False" Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" />
          </Grid>
        </Grid>
        <Border Grid.Column="1" Background="#121A28" CornerRadius="10" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
          <TextBlock Text="CONFIGURACIÓN" FontSize="13" Foreground="#6CE0C1" />
          <TextBlock x:Name="PreviewTitle" Text="Selecciona un campeón" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="PreviewState" Text="Al confirmar se aplicará tu perfil o Lolalytics D2+." FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="PreviewSource" FontSize="11" Foreground="#94A5BD" TextWrapping="Wrap" />
          <TextBlock Text="Runas" FontWeight="SemiBold" /><TextBlock x:Name="PreviewRunes" Text="Sin configuración cargada" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Habilidades y compra" FontWeight="SemiBold" /><TextBlock x:Name="PreviewItems" FontSize="12" TextWrapping="Wrap" />
          <Button Content="Ver en el editor" Click="PreviewEditClick" />
        </StackPanel></ScrollViewer></Border></Grid>
      </TabViewItem>
      <TabViewItem x:Name="LoadoutTab" IsClosable="False" Header="Runas y objetos">
        <Border Background="#121A28" CornerRadius="12" Padding="20">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <StackPanel Spacing="7">
                <TextBlock Text="02 / PREPARACIÓN" FontSize="13" Foreground="#6CE0C1" CharacterSpacing="150" />
                <TextBlock Text="Runas y ruta de objetos" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
              <Expander Header="Favoritos y selección automática" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                  <TextBlock Text="Marca ★ junto al nombre del campeón en la lista para guardarlo como favorito de esta posición." TextWrapping="Wrap" FontSize="12" />
                  <TextBlock x:Name="FavoritesText" Text="Cargando favoritos…" Foreground="#94A5BD" TextWrapping="Wrap" FontSize="12" />
                  <CheckBox x:Name="AutoHoverBox" Content="Preseleccionar la mejor opción (favoritos si los hay)" Checked="AutomationChanged" Unchecked="AutomationChanged" />
                  <CheckBox x:Name="AutoLockBox" Content="Confirmar automáticamente antes de que termine la selección" Checked="AutomationChanged" Unchecked="AutomationChanged" />
                  <NumberBox x:Name="AutoLockSecondsBox" Header="Segundos restantes para confirmar" Minimum="1" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Compact" Value="1" ValueChanged="AutoLockSecondsChanged" />
                  <TextBlock x:Name="AutomationText" Text="Esperando tu turno de selección." Foreground="#6CE0C1" TextWrapping="Wrap" FontSize="12" />
                  <TextBlock Text="La prioridad combina winrate, confianza por partidas y composición. No usa tu historial personal. El puntaje es orientativo; no representa la probabilidad de ganar tu partida." Foreground="#94A5BD" TextWrapping="Wrap" FontSize="12" />
                  <CheckBox Checked="AutomationChanged" Content="Aplicar runas y objetos al confirmar campeón (fallback D2+)" Unchecked="AutomationChanged" x:Name="AutoLoadoutBox" />
                  <StackPanel Spacing="8" Orientation="Horizontal">
                    <Button Content="Reintentar configuración" Click="RetryLoadoutClick" />
                    <Button Content="Ver configuración preparada" Click="ViewPreparedClick" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProfilesBox" Header="Mis perfiles" SelectionChanged="ProfileChanged"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding ChampionId, Converter={StaticResource ProfileChampionConverter}}" /><TextBlock Text="{Binding Role}" FontSize="11" Foreground="#94A5BD" /><TextBlock Text="{Binding Source}" FontSize="10" Foreground="#94A5BD" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <Button Grid.Column="1" Content="Nuevo" Click="NewClick" VerticalAlignment="Bottom" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cargar Lolalytics D2+" Click="LolalyticsClick" />
                <Button Content="Ver D2+ en Lolalytics ↗" Click="OpenLolalyticsClick" />
              </StackPanel>
              <Button Content="Importar build .json" Click="ImportJsonFileClick" />
              <TextBlock x:Name="SourceText" Text="Personalizada" Foreground="#94A5BD" TextWrapping="Wrap" FontSize="12" />
              <ComboBox x:Name="ProfileChampionBox" Header="Campeón de esta configuración" />
              <ComboBox x:Name="ProfileRoleBox" Header="Posición de esta configuración" />
              <TextBox x:Name="ProfileName" Header="Nombre del perfil" Text="Mi configuración" />
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                  <ComboBox x:Name="PrimaryBox" Header="Rama primaria" ItemTemplate="{StaticResource RuneChoiceTemplate}" SelectionChanged="PrimaryChanged" />
                  <TextBlock Text="Runas principales · una por fila" Foreground="#94A5BD" TextWrapping="Wrap" />
                  <StackPanel x:Name="PrimaryRuneGrid" Spacing="8" />
                  <StackPanel Visibility="Collapsed"><ComboBox x:Name="P0" /><ComboBox x:Name="P1" /><ComboBox x:Name="P2" /><ComboBox x:Name="P3" /></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox x:Name="SecondaryBox" Header="Rama secundaria" ItemTemplate="{StaticResource RuneChoiceTemplate}" SelectionChanged="SecondaryChanged" />
                  <TextBlock Text="Runas secundarias · elige dos filas" Foreground="#94A5BD" TextWrapping="Wrap" />
                  <StackPanel x:Name="SecondaryRuneGrid" Spacing="8" />
                  <StackPanel Visibility="Collapsed"><ComboBox x:Name="S0" /><ComboBox x:Name="S1" /></StackPanel>
                  <TextBlock Text="Fragmentos" Foreground="#94A5BD" />
                  <ComboBox x:Name="F0" />
                  <ComboBox x:Name="F1" />
                  <ComboBox x:Name="F2" />
                </StackPanel>
              </Grid>
              <TextBox x:Name="ItemsText" Header="Ruta de compra · bloques y objetos en varias líneas" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" PlaceholderText="Inicio:&#xA;1056, 2003, 2003&#xA;Núcleo:&#xA;6655, 3020, 3089" />
              <TextBlock Text="Nombre del bloque: seguido de IDs separados por comas, espacios o saltos de línea. Repite un ID para indicar cantidad. Los nombres especiales importados se muestran entre comillas para conservarlos." Foreground="#94A5BD" FontSize="12" TextWrapping="Wrap" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="ItemSearch" PlaceholderText="Buscar objeto o ID en el catálogo" TextChanged="ItemSearchChanged" SuggestionChosen="ItemChosen" />
                <Button Grid.Column="1" Content="Añadir objeto" Click="AddItemClick" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Guardar perfil" Click="SaveClick" />
                <Button Content="JSON ↔" Click="JsonClick" />
                <Button Content="Eliminar" Click="DeleteClick" />
              </StackPanel>
              <Border Height="1" Background="#29364B" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Aplicar runas a League" Click="ImportRunesClick" />
                <Button Content="Enviar objetos a League" Click="ImportItemsClick" />
              </StackPanel>
              <TextBlock Text="Las runas usan una página llamada DraftOptimizer. Los objetos aparecen como un conjunto recomendado dentro del juego." Foreground="#94A5BD" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabViewItem>
      <TabViewItem x:Name="SimulationTab" Header="Simulación" IsClosable="False">
        <Grid Margin="0,12,0,0" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="SimulationRoleBox" Header="Posición" VerticalAlignment="Bottom" SelectionChanged="SimulationRoleChanged" />
            <TextBox x:Name="SimulationSearchBox" Grid.Column="1" Header="Buscar campeón" TextChanged="SimulationSearchChanged" />
            <ToggleSwitch x:Name="SimulationPortraitToggle" Grid.Column="2" Header="Retratos" Toggled="SimulationPortraitToggled" />
          </Grid>
          <TextBlock x:Name="SimulationTurnText" Grid.Row="1" TextWrapping="Wrap" />
          <Grid Grid.Row="2" ColumnSpacing="15"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock x:Name="SimulationBlueText" TextWrapping="Wrap" /><TextBlock x:Name="SimulationRedText" Grid.Column="1" TextWrapping="Wrap" /></Grid>
          <GridView x:Name="SimulationCandidates" Grid.Row="3" SelectionMode="Single" ItemTemplate="{StaticResource ChampionRowTemplate}" ItemsPanel="{StaticResource ChampionRowsPanel}" ItemContainerStyle="{StaticResource ChampionContainerStyle}"><GridView.ItemContainerTransitions><TransitionCollection /></GridView.ItemContainerTransitions></GridView>
          <StackPanel Grid.Row="4" Spacing="8"><TextBlock x:Name="SimulationMetricText" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="SimulationPickButton" Content="Confirmar pick simulado" Click="SimulationPickClick" /><Button Content="Deshacer" Click="SimulationUndoClick" /><Button Content="Reiniciar" Click="SimulationResetClick" /></StackPanel></StackPanel>
        </Grid>
      </TabViewItem>
      <TabViewItem Header="Estado del draft" IsClosable="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Background="#151F30" CornerRadius="8" Padding="14">
            <StackPanel Spacing="7">
              <TextBlock x:Name="DraftText" Text="Abre League para sincronizar la selección." TextWrapping="Wrap" />
              <TextBlock x:Name="DraftWinrateText" Text="WR del draft: esperando selección." Foreground="#6CE0C1" TextWrapping="Wrap" FontSize="13" />
              <Expander HorizontalContentAlignment="Stretch" Header="Composición y posiciones" HorizontalAlignment="Stretch">
                <TextBlock x:Name="TeamsText" Foreground="#94A5BD" TextWrapping="Wrap" FontSize="12" />
              </Expander>
              <TextBlock x:Name="AutomationSummary" Text="Auto: sin favoritos configurados." Foreground="#6CE0C1" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="Runas y objetos: esperando campeón confirmado." FontSize="12" TextWrapping="Wrap" Foreground="#94A5BD" x:Name="LoadoutStatus" />
              <CheckBox x:Name="FollowBox" Content="Seguir mi campeón y posición del cliente" IsChecked="True" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabViewItem>
    </TabView>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Name="DataText" Text="Cargando catálogo…" Foreground="#71839D" FontSize="11" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
        <HyperlinkButton Content="Acerca de · proyecto independiente de Riot Games" Click="AboutClick" FontSize="11" Padding="0" />
      </StackPanel>
      <Button Grid.Column="1" Content="Actualizar datos" Click="RefreshClick" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>

